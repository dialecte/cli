{
	"name": "@dialecte/cli",
	"version": "0.1.0",
	"description": "Dialecte CLI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dialecte/cli.git"
	},
	"bin": {
		"dialecte": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"exports": {
		"./lookups": {
			"types": "./dist/lookups.d.ts",
			"default": "./dist/lookups.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"type-check": "tsc --noEmit",
		"lint:check": "oxlint",
		"lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"test": "vitest",
		"test:run": "vitest run",
		"check": "npm run type-check && npm run lint:check && npm run format:check && npm run test:run",
		"prepublishOnly": "node src/release-check.ts && npm run build",
		"prepare": "husky"
	},
	"dependencies": {
		"jsonc-parser": "3.3.1",
		"oxfmt": "^0.53.0"
	},
	"devDependencies": {
		"@dialecte/core": "file:../core",
		"@types/node": "^22.0.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@xmldom/xmldom": "0.8.15",
		"husky": "^9.1.7",
		"oxlint": "^1.68.0",
		"tsup": "^8.5.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"typescript": ">=5.4"
	},
	"engines": {
		"node": ">=22.18"
	}
}
