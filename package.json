{
	"name": "@dialecte/cli",
	"version": "0.4.0",
	"description": "Dialecte CLI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dialecte/cli.git"
	},
	"bin": {
		"dialecte": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"exports": {
		"./lookups": {
			"types": "./dist/lookups.d.ts",
			"default": "./dist/lookups.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"type-check": "tsc --noEmit",
		"lint:check": "oxlint",
		"lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"test": "vitest",
		"test:run": "vitest run",
		"test:hook": "node src/cli.ts gate --hook",
		"skills:check": "node src/cli.ts skills check",
		"check": "npm run type-check && npm run lint:check && npm run format:check",
		"prepublishOnly": "node src/release-check.ts && npm run build",
		"prepare": "husky"
	},
	"dependencies": {
		"jsonc-parser": "3.3.1",
		"oxfmt": "^0.75.0"
	},
	"devDependencies": {
		"@babel/parser": "8.0.7",
		"@babel/traverse": "8.0.7",
		"@dialecte/core": "^0.8.0",
		"@types/node": "^22.0.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@xmldom/xmldom": "0.8.15",
		"husky": "^9.1.7",
		"oxlint": "^1.68.0",
		"tsup": "^8.5.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"typescript": ">=5.4 <7"
	},
	"engines": {
		"node": ">=22.18"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true,
		"file:../../../core": false,
		"file:../../../../core": false
	},
	"dialecte": {
		"profile": "contributor",
		"gate": {
			"fast": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "tests",
					"run": "node src/scoped-tests.ts",
					"counts": "tests",
					"scoped": true
				},
				{
					"name": "rules",
					"run": "node src/cli.ts rules",
					"scoped": true
				}
			],
			"full": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "skills",
					"run": "npm run skills:check"
				},
				{
					"name": "build",
					"run": "npm run build"
				},
				{
					"name": "tests",
					"run": "npx vitest run",
					"counts": "tests"
				},
				{
					"name": "rules",
					"run": "node src/cli.ts rules",
					"scoped": true
				}
			]
		},
		"contrib": {
			"steps": []
		},
		"tdd": {
			"production": [
				"test/suite-guard"
			]
		},
		"stepEvents": 1
	}
}
